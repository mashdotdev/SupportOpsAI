{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Next.js development",
			"type": "shell",
			"command": "bun",
			"args": [
				"run",
				"--cwd",
				"frontend",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Backend development",
			"type": "shell",
			"command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"args": [
				"-m",
				"uvicorn",
				"main:app",
				"--reload",
				"--port",
				"8000",
				"--no-access-log"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}
