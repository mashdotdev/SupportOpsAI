# Use the SAME Neon branch/database as frontend/.env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
BACKEND_API_TOKEN=replace-with-the-same-random-secret-as-the-nextjs-server
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openrouter/free
# Optional OpenAI key for the Agents SDK Traces dashboard only.
# Inference still uses OPENROUTER_API_KEY and free models.
OPENAI_API_KEY=
# Optional dedicated export key, preferred over OPENAI_API_KEY when provided.
OPENAI_TRACING_API_KEY=
OPENAI_AGENTS_DISABLE_TRACING=false
# true uploads prompts, model/tool inputs/outputs, and retrieved passages to OpenAI.
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=false
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-key
# Use a different collection for every Neon branch/environment.
QDRANT_COLLECTION=supportops_development_bge_small_v1
AWS_ACCESS_KEY_ID=your-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret
AWS_ENDPOINT_URL_S3=https://your-branch-storage-endpoint
AWS_REGION=us-east-2
STORAGE_BUCKET=knowledge-documents
FRONTEND_ORIGIN=http://localhost:3000
# Generate once with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable and secret across API and notification-worker deployments.
INTEGRATION_ENCRYPTION_KEY=
# Each public customer turn reserves three model requests (including tool continuations).
WIDGET_DAILY_MODEL_REQUESTS=45
EMBEDDING_MODEL_PATH=data/models/bge-small-en-v1.5
# Shared by knowledge-base playground, saved-agent chat, and website widgets.
# Set false temporarily to compare against the previous tool-first path.
CHAT_PREFETCH_KNOWLEDGE=true
# Load and warm the local embedding model before accepting API traffic.
CHAT_WARMUP_EMBEDDINGS=true
