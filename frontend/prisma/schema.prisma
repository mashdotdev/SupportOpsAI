generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/// The subject length CHECK is maintained in migration SQL.
model SupportTicket {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Text
  subject   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "support_tickets_user_created_idx")
  @@map("support_tickets")
  @@schema("public")
}

model KnowledgeDocument {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Text
  filename         String    @db.Text
  mediaType        String    @map("media_type") @db.Text
  byteSize         Int       @map("byte_size")
  storageKey       String    @unique @map("storage_key") @db.Text
  stagingKey       String    @unique @map("staging_key") @db.Text
  checksum         String?   @db.Text
  status           String    @default("awaiting_upload") @db.Text
  indexGeneration  String?   @map("index_generation") @db.Uuid
  activeGeneration String?   @map("active_generation") @db.Uuid
  chunkCount       Int       @default(0) @map("chunk_count")
  error            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  jobs             KnowledgeJob[]
  agents           AiAgentDocument[]

  @@unique([id, userId], map: "knowledge_documents_id_user_key")
  @@index([userId, createdAt(sort: Desc)], map: "knowledge_documents_user_created_idx")
  @@index([status, createdAt], map: "knowledge_documents_status_created_idx")
  @@map("knowledge_documents")
  @@schema("public")
}

model KnowledgeJob {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  operation  String   @db.Text
  generation String   @db.Uuid
  status     String   @default("queued") @db.Text
  attempts   Int      @default(0)
  runAfter   DateTime @default(now()) @map("run_after") @db.Timestamptz(6)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseToken String?  @map("lease_token") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([documentId, operation, generation], map: "knowledge_jobs_document_operation_generation_key")
  @@index([status, runAfter], map: "knowledge_jobs_status_run_after_idx")
  @@map("knowledge_jobs")
  @@schema("public")
}

model AiAgent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Text
  name          String   @db.Text
  modelId       String   @map("model_id") @db.Text
  instructions  String   @db.Text
  authority     Json     @db.JsonB
  knowledgeMode String   @default("all") @map("knowledge_mode") @db.Text
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  documents     AiAgentDocument[]

  @@unique([id, userId], map: "ai_agents_id_user_key")
  @@index([userId, updatedAt(sort: Desc)], map: "ai_agents_user_updated_idx")
  @@map("ai_agents")
  @@schema("public")
}

model AiAgentDocument {
  agentId    String @map("agent_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  userId     String @map("user_id") @db.Text
  agent      AiAgent @relation(fields: [agentId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)
  document   KnowledgeDocument @relation(fields: [documentId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)

  @@id([agentId, documentId])
  @@index([documentId, userId], map: "ai_agent_documents_document_user_idx")
  @@map("ai_agent_documents")
  @@schema("public")
}

model AgentConversation {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Text
  source       String   @db.Text
  agentId      String?  @map("agent_id") @db.Uuid
  agentName    String   @map("agent_name") @db.Text
  agentVersion Int?     @map("agent_version")
  modelId      String   @map("model_id") @db.Text
  subject      String   @db.Text
  status       String   @default("in_progress") @db.Text
  reason       String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  turns        AgentTurn[]
  events       AgentActivityEvent[]

  @@unique([id, userId])
  @@index([userId, source, createdAt(sort: Desc)], map: "agent_conversations_owner_created_idx")
  @@index([userId, updatedAt(sort: Desc)], map: "agent_conversations_owner_updated_idx")
  @@map("agent_conversations")
  @@schema("public")
}

model AgentTurn {
  id             String   @id @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Text
  question       String   @db.Text
  answer         String?  @db.Text
  citations      Json     @default("[]") @db.JsonB
  responseType   String?  @map("response_type") @db.Text
  status         String   @default("running") @db.Text
  error          String?  @db.Text
  durationMs     Int?     @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  conversation   AgentConversation @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade)

  // The single-running-turn partial unique index is maintained in migration SQL.
  @@index([conversationId, createdAt, id], map: "agent_turns_conversation_created_idx")
  @@map("agent_turns")
  @@schema("public")
}

model AgentActivityEvent {
  id             BigInt   @id @default(autoincrement())
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Text
  kind           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   AgentConversation @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, id], map: "agent_activity_events_owner_id_idx")
  @@map("agent_activity_events")
  @@schema("public")
}
