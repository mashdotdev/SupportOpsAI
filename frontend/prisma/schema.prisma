generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/// The subject length CHECK is maintained in migration SQL.
model SupportTicket {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Text
  subject   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "support_tickets_user_created_idx")
  @@map("support_tickets")
  @@schema("public")
}

model KnowledgeDocument {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Text
  filename         String    @db.Text
  mediaType        String    @map("media_type") @db.Text
  byteSize         Int       @map("byte_size")
  storageKey       String    @unique @map("storage_key") @db.Text
  stagingKey       String    @unique @map("staging_key") @db.Text
  checksum         String?   @db.Text
  status           String    @default("awaiting_upload") @db.Text
  indexGeneration  String?   @map("index_generation") @db.Uuid
  activeGeneration String?   @map("active_generation") @db.Uuid
  chunkCount       Int       @default(0) @map("chunk_count")
  error            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  jobs             KnowledgeJob[]
  agents           AiAgentDocument[]

  @@unique([id, userId], map: "knowledge_documents_id_user_key")
  @@index([userId, createdAt(sort: Desc)], map: "knowledge_documents_user_created_idx")
  @@index([status, createdAt], map: "knowledge_documents_status_created_idx")
  @@map("knowledge_documents")
  @@schema("public")
}

model KnowledgeJob {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  operation  String   @db.Text
  generation String   @db.Uuid
  status     String   @default("queued") @db.Text
  attempts   Int      @default(0)
  runAfter   DateTime @default(now()) @map("run_after") @db.Timestamptz(6)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseToken String?  @map("lease_token") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([documentId, operation, generation], map: "knowledge_jobs_document_operation_generation_key")
  @@index([status, runAfter], map: "knowledge_jobs_status_run_after_idx")
  @@map("knowledge_jobs")
  @@schema("public")
}

model AiAgent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Text
  name          String   @db.Text
  modelId       String   @map("model_id") @db.Text
  instructions  String   @db.Text
  authority     Json     @db.JsonB
  knowledgeMode String   @default("all") @map("knowledge_mode") @db.Text
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  documents     AiAgentDocument[]
  slackNotifications Boolean @default(false) @map("slack_notifications")
  slackTestDelivery Boolean @default(false) @map("slack_test_delivery")

  @@unique([id, userId], map: "ai_agents_id_user_key")
  @@index([userId, updatedAt(sort: Desc)], map: "ai_agents_user_updated_idx")
  @@map("ai_agents")
  @@schema("public")
}

model AiAgentDocument {
  agentId    String @map("agent_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  userId     String @map("user_id") @db.Text
  agent      AiAgent @relation(fields: [agentId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)
  document   KnowledgeDocument @relation(fields: [documentId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)

  @@id([agentId, documentId])
  @@index([documentId, userId], map: "ai_agent_documents_document_user_idx")
  @@map("ai_agent_documents")
  @@schema("public")
}

model AgentConversation {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Text
  source       String   @db.Text
  agentId      String?  @map("agent_id") @db.Uuid
  agentName    String   @map("agent_name") @db.Text
  agentVersion Int?     @map("agent_version")
  modelId      String   @map("model_id") @db.Text
  subject      String   @db.Text
  status       String   @default("in_progress") @db.Text
  reason       String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  turns        AgentTurn[]
  events       AgentActivityEvent[]
  escalationCycle Int @default(1) @map("escalation_cycle")
  notifications NotificationJob[]
  widgetRevisionId String? @map("widget_revision_id") @db.Uuid
  widgetRevision WidgetRevision? @relation(fields: [widgetRevisionId], references: [id])
  visitorName String? @map("visitor_name") @db.Text
  visitorEmail String? @map("visitor_email") @db.Text
  pageOrigin String? @map("page_origin") @db.Text
  customerFeedback String? @map("customer_feedback") @db.Text
  widgetSession WidgetSession?

  @@unique([id, userId])
  @@index([userId, source, createdAt(sort: Desc)], map: "agent_conversations_owner_created_idx")
  @@index([userId, updatedAt(sort: Desc)], map: "agent_conversations_owner_updated_idx")
  @@map("agent_conversations")
  @@schema("public")
}

model AgentTurn {
  id             String   @id @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Text
  question       String   @db.Text
  answer         String?  @db.Text
  citations      Json     @default("[]") @db.JsonB
  responseType   String?  @map("response_type") @db.Text
  status         String   @default("running") @db.Text
  error          String?  @db.Text
  durationMs     Int?     @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  conversation   AgentConversation @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade)

  // The single-running-turn partial unique index is maintained in migration SQL.
  @@index([conversationId, createdAt, id], map: "agent_turns_conversation_created_idx")
  @@map("agent_turns")
  @@schema("public")
}

model AgentActivityEvent {
  id             BigInt   @id @default(autoincrement())
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Text
  kind           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   AgentConversation @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, id], map: "agent_activity_events_owner_id_idx")
  @@map("agent_activity_events")
  @@schema("public")
}

model SlackConnection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Text
  name String @db.Text
  destination String @db.Text
  secret String? @db.Text
  enabled Boolean @default(true)
  version Int @default(1)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  lastSentAt DateTime? @map("last_sent_at") @db.Timestamptz(6)
  lastError String? @map("last_error") @db.Text
  nextSendAt DateTime @default(now()) @map("next_send_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  jobs NotificationJob[]
  @@unique([id,userId])
  @@map("slack_connections")
  @@schema("public")
}

model NotificationJob {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Text
  connectionId String @map("connection_id") @db.Uuid
  connectionVersion Int @map("connection_version")
  conversationId String? @map("conversation_id") @db.Uuid
  agentId String? @map("agent_id") @db.Uuid
  agentName String @map("agent_name") @db.Text
  cycle Int @default(1)
  kind String @db.Text
  mode String @db.Text
  source String @db.Text
  status String @db.Text
  question String @db.Text
  reason String @db.Text
  attempts Int @default(0)
  maxAttempts Int @default(3) @map("max_attempts")
  explicitDelivery Boolean @default(false) @map("explicit_delivery")
  runAfter DateTime @default(now()) @map("run_after") @db.Timestamptz(6)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseToken String? @map("lease_token") @db.Uuid
  error String? @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  connection SlackConnection @relation(fields:[connectionId,userId],references:[id,userId])
  conversation AgentConversation? @relation(fields:[conversationId,userId],references:[id,userId],onDelete:Cascade)
  deliveries NotificationAttempt[]
  // Escalation deduplication uses a partial unique index in migration SQL.
  @@index([status,runAfter], map:"notification_jobs_queue_idx")
  @@index([userId,createdAt(sort:Desc)], map:"notification_jobs_owner_created_idx")
  @@map("notification_jobs")
  @@schema("public")
}

model NotificationAttempt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId String @map("job_id") @db.Uuid
  number Int
  status String @db.Text
  httpStatus Int? @map("http_status")
  error String? @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  job NotificationJob @relation(fields:[jobId],references:[id],onDelete:Cascade)
  @@unique([jobId,number])
  @@map("notification_attempts")
  @@schema("public")
}

model WebsiteWidget {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Text
  draft Json @default("{}") @db.JsonB
  version Int @default(1)
  enabled Boolean @default(false)
  publishedRevisionId String? @map("published_revision_id") @db.Uuid
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  revisions WidgetRevision[] @relation("WidgetRevisions")
  // The composite FK to the active revision is maintained in migration SQL.
  sessions WidgetSession[]
  @@unique([id,userId])
  @@map("website_widgets")
  @@schema("public")
}

model WidgetRevision {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  widgetId String @map("widget_id") @db.Uuid
  userId String @map("user_id") @db.Text
  number Int
  configuration Json @db.JsonB
  agent Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  widget WebsiteWidget @relation("WidgetRevisions", fields: [widgetId,userId], references: [id,userId], onDelete: Cascade)
  conversations AgentConversation[]
  @@unique([widgetId,number])
  @@unique([id,widgetId,userId])
  @@map("widget_revisions")
  @@schema("public")
}

model WidgetSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  widgetId String @map("widget_id") @db.Uuid
  userId String @map("user_id") @db.Text
  conversationId String @unique @map("conversation_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Text
  siteOrigin String @map("site_origin") @db.Text
  expiresAt DateTime @default(dbgenerated("now() + interval '7 days'")) @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  widget WebsiteWidget @relation(fields: [widgetId,userId], references: [id,userId], onDelete: Cascade)
  conversation AgentConversation @relation(fields: [conversationId,userId], references: [id,userId], onDelete: Cascade)
  @@unique([conversationId,userId])
  @@index([widgetId,createdAt(sort: Desc)], map:"widget_sessions_widget_created_idx")
  @@map("widget_sessions")
  @@schema("public")
}

model WidgetRateLimit {
  bucket String @db.Text
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  used Int @default(1)
  @@id([bucket,windowStart])
  @@map("widget_rate_limits")
  @@schema("public")
}
